# 安装后文件名：/etc/nginx/sites-available/acme.conf
# 作用：80 端口 — Let's Encrypt HTTP-01 校验 + Debian 测试欢迎页。
# 站点内容请写 ssl.conf（443），不要写在这里。
# 部署时替换：【$SET_SERVER_NAME】【$SET_HTTP_SERVER_ROOT】【$HOME_INDEX】

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name 【$SET_SERVER_NAME】;

    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root 【$SET_HTTP_SERVER_ROOT】;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.nginx-debian.html;
        # 签发完证书后请注释上面，取消注释下面获得默认跳转443
        # return 301 https://$host$request_uri;
    }

    access_log 【$HOME_INDEX】/Logs/nginx/acme.log;
    error_log 【$HOME_INDEX】/Logs/nginx/acme_error.log;
}