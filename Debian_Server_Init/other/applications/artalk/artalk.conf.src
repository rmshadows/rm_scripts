# 安装后：/etc/nginx/snippets/artalk.conf
# Artalk 子路径反代片段（location 块，不含 server 块、不含 SSL）。
# 路径与端口由 setupNginxForArtalk.sh 填入。
# 启用：在主站（如 ssl.conf）的 server { } 内加一行：
#   include /etc/nginx/snippets/artalk.conf;
# 然后： sudo nginx -t && sudo systemctl reload nginx
# 前端 embed 的 server 地址 = 主站地址 + 子路径，如 https://example.com__REVERSE_PROXY_PATH__

location __REVERSE_PROXY_PATH__ {
    proxy_redirect off;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:__RUN_PORT__/;
}
