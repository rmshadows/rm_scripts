#!/bin/bash
# docx 转 pdf
# 需要 libreoffice

# 获取当前目录

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
NAUTILUS_ROOT="$SCRIPT_DIR"
while [ "$NAUTILUS_ROOT" != "/" ] && [ ! -d "$NAUTILUS_ROOT/lib/Office" ]; do
  NAUTILUS_ROOT="$(dirname "$NAUTILUS_ROOT")"
done

# 输入过滤（防点错）
if [ -f "$NAUTILUS_ROOT/lib/Office/nautilus_filter.sh" ]; then
  # shellcheck disable=SC1091
  source "$NAUTILUS_ROOT/lib/Office/nautilus_filter.sh"
  office_filter_by_ext 1 0 doc docx wps odt rtf -- "$@" || exit 1
  set -- "${OFFICE_FILES[@]}"
fi
current_dir=$(pwd)

# 创建 output_pdf 目录（如果不存在的话）
output_dir="$current_dir/output_pdf"
mkdir -p "$output_dir"

# 遍历选中的文件（已按扩展名过滤）
for file in "$@"; do
    echo "正在转换: $file"
    libreoffice --headless --convert-to pdf "$file" --outdir "$output_dir"
done

notify-send "所有文件已转换完成，PDF 保存在 $output_dir 目录中。"

