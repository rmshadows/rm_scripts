# 安装后：/etc/nginx/snippets/hackchat.conf
# HackChat 子路径反代片段（location 块，不含 server 块、不含 SSL）。
# Web：__REVERSE_PROXY_PATH__ -> 127.0.0.1:__RUN_PORT__/    WS：__WS_PATH__ -> 127.0.0.1:__WS_PORT__
# 启用：在主站（如 ssl.conf）的 server { } 内加一行：
#   include /etc/nginx/snippets/hackchat.conf;
# 然后： sudo nginx -t && sudo systemctl reload nginx

location __REVERSE_PROXY_PATH__ {
    proxy_pass http://127.0.0.1:__RUN_PORT__/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# WebSocket（不剥前缀，后端按 __WS_PATH__ 提供 wss）
location __WS_PATH__ {
    proxy_pass http://127.0.0.1:__WS_PORT__;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
}
