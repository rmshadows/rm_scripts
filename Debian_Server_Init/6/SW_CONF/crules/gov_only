# 模板：gov_only
# 只放行指定内网 IP，其余进出都丢。把下面的 IP 改成你的再启用。
# 选用：sudo sw-rules
# 改完：sudo shorewall check && sudo shorewall reload
# 网卡/区域配合 interfaces、zones 里的 gov / net。
#
# ACTION		SOURCE		DEST		PROTO	DEST	SOURCE
#							PORT	PORT(S)
?SECTION ALL
?SECTION ESTABLISHED
?SECTION RELATED
?SECTION INVALID
?SECTION UNTRACKED
?SECTION NEW
Invalid(DROP)	net		$FW		tcp

# ============================================================
# 放行指定主机（改 IP 后使用；下面两行已启用）
# ============================================================
ACCEPT	net:192.168.1.11	all
ACCEPT	all	net:192.168.1.11

# ============================================================
# 再放行一台时，复制上面两行，改 IP，取消注释
# ============================================================
# ACCEPT	net:192.168.1.12	all
# ACCEPT	all	net:192.168.1.12

# ============================================================
# 丢掉其余外网进出（已启用，放最后）
# ============================================================
DROP	net	all
DROP	all	net
