#!/bin/bash
# 停止所有 GoAccess 报告生成进程（systemd 停止服务时调用）
# systemd 会先 SIGTERM 整个 cgroup，这里做兜底清理 PID 文件
PID_DIR="【$GOACCESS_DIR】/pids"
# 兜底：占位符未被正确替换时直接报错（正常安装不会触发）
case "$PID_DIR" in
  *【*) echo "stop.sh 占位符未替换（PID_DIR=$PID_DIR），请重新运行 goaccess.sh"; exit 1;;
esac
if [[ -d "$PID_DIR" ]]; then
  rm -f "$PID_DIR"/*.pid
fi
# 兜底：杀本用户下所有 goaccess 进程
pkill -u "$(whoami)" goaccess 2>/dev/null || true
exit 0
