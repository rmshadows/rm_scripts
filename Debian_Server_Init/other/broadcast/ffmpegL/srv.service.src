[Unit]
Description=【$new_srv_name】 ffmpeg 推流（低内存，适合 1G）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=【$USER】
Group=【$USER】
WorkingDirectory=【$new_srv_path】
ExecStart=【$new_srv_path】/【$new_srv_name】.sh
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStopSec=15
KillMode=mixed
PrivateTmp=true
NoNewPrivileges=true

# 可选：1G 机器建议打开，防止推流把整机 OOM。配置高的不用开。
# 安装脚本会询问；也可事后: sudo systemctl edit 【$new_srv_name】
# MemoryMax=384M
# MemoryHigh=256M

Restart=always
RestartSec=8s
StartLimitIntervalSec=120
StartLimitBurst=8

[Install]
WantedBy=multi-user.target
