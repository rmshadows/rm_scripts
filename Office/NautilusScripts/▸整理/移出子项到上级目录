#!/bin/bash
# 文件管理器用 bash 跑右键，不读 bashrc/zshrc。
# 自定义路径：~/.config/office/python-venv 写一行目录。
if [ -f "$HOME/.local/share/nautilus/lib/Office/nautilus_env.sh" ]; then
  . "$HOME/.local/share/nautilus/lib/Office/nautilus_env.sh"
elif [ -f "$HOME/.python_venv_activate" ]; then
  . "$HOME/.python_venv_activate" 2>/dev/null || true
fi
# 获取当前脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# 自 scripts/ 或其子目录向上找到含 lib/Office 的 nautilus 根
NAUTILUS_ROOT="$SCRIPT_DIR"
while [ "$NAUTILUS_ROOT" != "/" ] && [ ! -d "$NAUTILUS_ROOT/lib/Office" ]; do
    NAUTILUS_ROOT="$(dirname "$NAUTILUS_ROOT")"
done
LIB_DIR="$NAUTILUS_ROOT/lib/Office/"

# 获取右键点击的文件夹或文件路径
selected_item="$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"

# 去除换行符
selected_item=$(echo "$selected_item" | tr -d '\n')

# 调试输出：确认是否获取到了选中的文件夹或文件
echo "选中的项目路径：$selected_item"

# 检查文件/文件夹是否存在
if [ -z "$selected_item" ] || [ ! -e "$selected_item" ]; then
    zenity --error --text="选择的文件或文件夹不存在"
    exit 1
fi

# 执行转换操作（例如复制脚本）
cp "$LIB_DIR/move_subdirfiles_here.sh" "$selected_item"/../move_subdirfiles_here.sh

# 完成后显示信息框
# zenity --info --text="请复制到终端运行：./Office2txt.sh \"$selected_item\""
# gnome-terminal --working-directory="$(pwd)"
gnome-terminal --working-directory="$(pwd)" -- bash -c "./move_subdirfiles_here.sh ; echo \"按任意键关闭终端...\"; read -r -n 1"

