#!/bin/bash
# ============================================================
# Nautilus 脚本：图片批量转 PDF
#
# 📌 使用方式（关键）：
# 1. 将本脚本放到：
#    ~/.local/share/nautilus/scripts/
#
# 2. 在文件管理器（Nautilus）中：
#    - 选中多个图片（jpg/png/jpeg）
#    - 右键 → “脚本” → 点击本脚本
#
# 3. Nautilus 会把你选中的文件路径作为参数传入：
#    "$1" = 第一个选中的文件
#    "$@" = 所有选中的文件
#
# 示例：
#   你选中：
#     /home/user/Pictures/a.jpg
#     /home/user/Pictures/b.png
#
#   那么：
#     $1  = /home/user/Pictures/a.jpg
#     $@  = a.jpg b.png（完整路径）
#
# ============================================================


# ============================================================
# 0. 加载环境变量
#    有些系统 Nautilus 不加载 shell 环境，所以需要手动 source
# ============================================================
source ~/.zshrc


# ============================================================
# 1. 获取路径信息
# ============================================================

# 当前脚本所在目录（例如：~/.local/share/nautilus/scripts）
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# 工具库目录（你自己的 PDF_Tools）
# 示例：
# ~/.local/share/nautilus/lib/Office/PDF_Tools
LIB_DIR="$SCRIPT_DIR/../lib/Office/PDF_Tools"

# 用户选中的第一个文件所在目录（作为输出目录）
# 示例：
# /home/user/Pictures
TARGET_DIR="$(dirname "$1")"

# 临时工作目录（在目标目录下创建）
# 示例：
# /home/user/Pictures/PDF_Tools_WP
TMP_PDF_DIR="$TARGET_DIR/PDF_Tools_WP"


# ============================================================
# 2. 清理旧的临时目录
#    防止上一次运行残留影响
# ============================================================
rm -rf "$TMP_PDF_DIR"


# ============================================================
# 3. 复制工具到临时目录
#    为什么这么做：
#    - 不污染原工具目录
#    - 每次运行环境独立
# ============================================================
cp -r "$LIB_DIR" "$TMP_PDF_DIR"


# ============================================================
# 4. 创建 input 目录
#    ⚠️ 必须和 Python 脚本中的目录一致
#
# Python 中：
#    imageDir = "input"
# ============================================================
mkdir -p "$TMP_PDF_DIR/input"


# ============================================================
# 5. 复制用户选中的图片到 input/
#
# "$@" = 所有选中的文件
# ============================================================
for file in "$@"; do
    cp "$file" "$TMP_PDF_DIR/input/"
done


# ============================================================
# 6. 进入临时目录执行 Python
# ============================================================
cd "$TMP_PDF_DIR" || exit 1


# ============================================================
# 7. 执行图片转 PDF
#
# 成功：
#   会生成 output.pdf
#
# 失败：
#   直接进入 else
# ============================================================
if python3 image2Pdf.py; then

    # ===== 检查输出文件 =====
    if [ -f "output.pdf" ]; then

        # ====================================================
        # 复制结果回原目录
        #
        # 示例：
        # output.pdf →
        # /home/user/Pictures/图片转PDF.pdf
        # ====================================================
        cp "output.pdf" "$TARGET_DIR/../图片转PDF.pdf"

        # 桌面通知
        notify-send "✅ 转化完成" "已保存：$TARGET_DIR/../图片转PDF.pdf"

    else
        # Python执行成功但没生成文件（异常情况）
        notify-send "❌ 转化失败" "未生成 output.pdf"
        exit 1
    fi

else
    # Python执行失败
    notify-send "❌ 转化失败" "脚本执行错误"
    exit 1
fi


# ============================================================
# 8. 返回上级目录
# ============================================================
cd ..


# ============================================================
# 9. 删除临时目录
#
# ⚠️ 注意：
# 如果复制失败，这里会把 output.pdf 一起删掉
# 可改成“确认成功后再删除”（更安全）
# ============================================================
rm -rf "$TMP_PDF_DIR"