  [submenu] (Color Mode - 亮暗色)
    [exec] (Toggle - 切换亮/暗) {~/.fluxbox/scripts/toggle/color-scheme.sh toggle}
    [exec] (Light - 亮色) {~/.fluxbox/scripts/toggle/color-scheme.sh light}
