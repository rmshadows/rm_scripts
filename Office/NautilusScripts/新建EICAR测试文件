#!/bin/bash
# 脚本：新建EICAR测试文件
# 用途：在当前文件夹新建 eicar_test.txt，内容为标准测试病毒字符串

EICAR_STRING='X5O!P%@AP[4\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*'

# 解析 Nautilus 当前目录（支持中文等 URL 编码路径）
resolve_target_dir() {
    if [ -n "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS" ]; then
        local selected
        selected=$(echo "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS" | head -n 1)
        if [ -d "$selected" ]; then
            printf '%s' "$selected"
        else
            dirname "$selected"
        fi
    elif [ -n "$NAUTILUS_SCRIPT_CURRENT_URI" ]; then
        python3 -c "
import sys, urllib.parse
uri = sys.argv[1]
path = urllib.parse.urlparse(uri).path
print(urllib.parse.unquote(path))
" "$NAUTILUS_SCRIPT_CURRENT_URI"
    else
        pwd
    fi
}

TARGET_DIR=$(resolve_target_dir)
TARGET_FILE="$TARGET_DIR/eicar_test.txt"

if [ ! -d "$TARGET_DIR" ]; then
    zenity --error --text="目标目录不存在：\n$TARGET_DIR" 2>/dev/null || echo "目标目录不存在: $TARGET_DIR"
    exit 1
fi

if ! printf '%s\n' "$EICAR_STRING" > "$TARGET_FILE" 2>/dev/null; then
    zenity --error --text="无法写入文件：\n$TARGET_FILE" 2>/dev/null || echo "无法写入: $TARGET_FILE"
    exit 1
fi

notify-send "EICAR 测试文件已创建" "$TARGET_FILE"
