bindPort = 【$FRPS_BIND_PORT】
auth.method = "token"
auth.token = "【$FRPS_AUTH_TOKEN】"
webServer.port = 【$FRPS_WEB_PORT】
# dashboard 用户名密码
webServer.user = "【$FRPS_WEB_USER】"
webServer.password = "【$FRPS_WEB_PASSWORD】"
Log.to = "【$HOME】/Logs/frp/frps.log"
Log.maxDays = 30
# 是否返回详细报错
detailedErrorsToClient = false
# 允许客户端映射的端口范围
allowPorts = [
  【$FRPS_ALLOW_PORTS】
]
