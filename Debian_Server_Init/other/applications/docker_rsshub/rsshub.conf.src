# 安装后：/etc/nginx/snippets/rsshub.conf
# RSSHub 子路径反代片段（location 块，不含 server 块、不含 SSL）。
# 路径与端口由 setupNginxForRsshub.sh 填入。
# 启用：在主站（如 ssl.conf）的 server { } 内加一行：
#   include /etc/nginx/snippets/rsshub.conf;
# 然后： sudo nginx -t && sudo systemctl reload nginx
# Feed 地址形如 https://example.com__REVERSE_PROXY_PATH__<route>

location __REVERSE_PROXY_PATH__ {
    proxy_pass http://127.0.0.1:__RUN_PORT__/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    expires 1d;
}
