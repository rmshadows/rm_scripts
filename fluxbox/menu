  [submenu] (Profiles - 场景)
    [exec] (Work - 工作) {~/.fluxbox/scripts/profile/switch-profile.sh work}
    [exec] (Play - 娱乐) {~/.fluxbox/scripts/profile/switch-profile.sh play}
    [exec] (Choose... - 选择场景) {~/.fluxbox/scripts/profile/switch-profile.sh}
    [exec] (Save Current - 保存当前) {~/.fluxbox/scripts/profile/save-profile.sh}
