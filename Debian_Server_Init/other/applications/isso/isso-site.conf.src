# 安装后：/etc/nginx/snippets/isso.conf
# isso 子路径反代片段（location 块，不含 server 块、不含 SSL）。
# 路径与端口由 setupNginxForIsso.sh 填入。
# 启用：在主站（如 ssl.conf）的 server { } 内加一行：
#   include /etc/nginx/snippets/isso.conf;
# 然后： sudo nginx -t && sudo systemctl reload nginx
# 前端 data-isso 填 https://example.com__REVERSE_PROXY_PATH__

location __REVERSE_PROXY_PATH__ {
    proxy_pass http://127.0.0.1:__RUN_PORT__/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # isso 依赖此头识别子路径
    proxy_set_header X-Script-Name __REVERSE_PROXY_PATH__;
    expires 1d;
}
