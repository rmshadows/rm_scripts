# 安装后文件名：/etc/nginx/sites-available/ssl.conf
# 作用：443 正式站。默认不启用。
# 启用：sudo ngx-site   或
#   ln -s /etc/nginx/sites-available/ssl.conf /etc/nginx/sites-enabled/ssl.conf
#   nginx -t && systemctl reload nginx
# 不要在本文件 listen 80（80 由 acme.conf 占用，续期靠它）。
# 主页文件放：【$SET_HTTP_SERVER_ROOT】/home_page
# 部署时替换：【$SET_SERVER_NAME】【$SET_HTTP_SERVER_ROOT】【$HOME_INDEX】【$phpfpmVersion】

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name 【$SET_SERVER_NAME】;

    ssl_certificate /etc/ssl/【$SET_SERVER_NAME】.pem;
    ssl_certificate_key /etc/ssl/【$SET_SERVER_NAME】.key;
    ssl_protocols TLSv1.3;
    ssl_ecdh_curve X25519:prime256v1:secp384r1;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=63072000" always;

    root 【$SET_HTTP_SERVER_ROOT】;
    index index.html index.htm index.php index.nginx-debian.html;

    access_log 【$HOME_INDEX】/Logs/nginx/ssl.log;
    error_log 【$HOME_INDEX】/Logs/nginx/ssl_error.log;

    # 主页：反代到本机 8000（root 是 home_page，不对外监听）
    location / {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 1d;
    }

    location /nres {
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime off;
    }

    location /res {
        autoindex on;
        limit_req zone=one burst=10;
        auth_basic "Passwd required";
        auth_basic_user_file 【$HOME_INDEX】/nginx_res_login;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php【$phpfpmVersion】-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}

# 主页静态站（仅本机，由上面 443 的 location / 反代进来）
server {
    listen 127.0.0.1:8000;
    server_name 【$SET_SERVER_NAME】;
    index index.html index.htm index.php;
    root 【$SET_HTTP_SERVER_ROOT】/home_page;
    access_log 【$HOME_INDEX】/Logs/nginx/home.log;
    error_log 【$HOME_INDEX】/Logs/nginx/home_error.log;
    error_page 301 302 403 404 502 https://【$SET_SERVER_NAME】/404.html;

    if ($request_method !~ ^(GET|HEAD|POST)$) {
        return 444;
    }

    location ~* ^/sample.html {
        return 301 /404.html;
    }

    location ~* \.(ini|php|cfg|sh|py|conf)$ {
        return 301 /404.html;
        deny all;
    }

    location ~* ^/(.git) {
        return 301 /404.html;
    }
}
