# GoAccess 通用配置（所有站点共用）
# https://goaccess.io/man
# 日志格式：nginx 默认 combined 格式
log-format COMBINED
date-format %d/%b/%Y
time-format %H:%M:%S

# 浏览器自动刷新（秒）。配合 start.sh 每分钟重生成报告
html-refresh 60

# 忽略爬虫（可选，true=不计入统计）
ignore-crawlers false

# GeoIP 数据库（世界地图/地理分布面板数据来源）
# SET_GA_SOURCE="src" 且 SET_GA_GEOIP=1 时由 goaccess.sh 自动取消注释
#geoip-database /usr/local/share/GeoIP/dbip-city-lite.mmdb

# 具体 -f 输入日志和 -o 输出 HTML 由 start.sh 按站点传入，不在此指定
#
# 界面语言：GoAccess 没有独立语言开关，靠运行时的 LANG 环境变量选内置 i18n。
# start.sh 已在调用 goaccess 前注入 LANG（值由 goaccess.sh 的 GOACCESS_LANG 决定）。
# 中文需系统已生成 zh_CN.UTF-8 locale（goaccess.sh 安装时会幂等生成）。
