#!/bin/bash
# ============================================================
# Nautilus 脚本：PDF 批量拆分（按页）
#
# 📌 使用方式：
# 1. 将本脚本放到：
#    ~/.local/share/nautilus/scripts/
#
# 2. 在文件管理器中：
#    - 选中一个或多个 PDF 文件
#    - 右键 → “脚本” → 点击本脚本
#
# 3. Nautilus 会自动传入参数：
#    "$1" = 第一个选中的PDF
#    "$@" = 所有选中的PDF
#
# 示例：
#   选中：
#     /home/user/docs/A.pdf
#     /home/user/docs/B.pdf
#
# ============================================================


# ============================================================
# 0. 加载环境变量（避免 Nautilus 环境不完整）
# ============================================================
source ~/.zshrc


# ============================================================
# 1. 路径定义
# ============================================================

# 当前脚本目录
# 示例：~/.local/share/nautilus/scripts
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# 工具库目录（包含 splitPDFPages.py）
LIB_DIR="$SCRIPT_DIR/../lib/Office/PDF_Tools"

# 目标目录（用户选中文件所在目录）
# 示例：/home/user/docs
TARGET_DIR="$(dirname "$1")"

# 临时工作目录
# 示例：/home/user/docs/PDF_Tools_WP
TMP_PDF_DIR="$TARGET_DIR/PDF_Tools_WP"


# ============================================================
# 2. 清理旧临时目录（避免残留干扰）
# ============================================================
rm -rf "$TMP_PDF_DIR"


# ============================================================
# 3. 复制工具到临时目录
#    - 保证运行环境独立
# ============================================================
cp -r "$LIB_DIR" "$TMP_PDF_DIR"


# ============================================================
# 4. 创建 input 目录
# ⚠️ 必须和 Python 脚本一致：
#    splitPDFPages.py 中使用的是 input/
# ============================================================
mkdir -p "$TMP_PDF_DIR/input"


# ============================================================
# 5. 复制选中的 PDF 到 input/
# ============================================================
for pdf in "$@"; do
    cp "$pdf" "$TMP_PDF_DIR/input/"
done


# ============================================================
# 6. 进入临时目录执行拆分
# ============================================================
cd "$TMP_PDF_DIR" || exit 1


# ============================================================
# 7. 执行 Python 拆分脚本
#
# 成功：
#   生成 split_pages/ 目录
#
# 示例：
#   split_pages/
#     ├── A_page1.pdf
#     ├── A_page2.pdf
#     ├── B_page1.pdf
# ============================================================
if python3 splitPDFPages.py; then

    # ===== 检查结果目录 =====
    if [ -d "split_pages" ]; then

        # ====================================================
        # 复制结果到原目录
        #
        # 示例：
        # /home/user/docs/PDF拆分结果/
        # ====================================================
        cp -r split_pages "$TARGET_DIR/../PDF拆分结果"

        notify-send "✅ 拆分完成" "已保存：$TARGET_DIR/../PDF拆分结果"

    else
        notify-send "❌ 拆分失败" "未生成 split_pages 目录"
        exit 1
    fi

else
    notify-send "❌ 拆分失败" "脚本执行错误"
    exit 1
fi


# ============================================================
# 8. 返回上级目录
# ============================================================
cd ..


# ============================================================
# 9. 删除临时目录
#
# ⚠️ 注意：
# 如果复制失败，这里会删除拆分结果
# 可改为“确认成功再删除”
# ============================================================
rm -rf "$TMP_PDF_DIR"