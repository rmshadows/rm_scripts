#!/bin/bash
# ============================================================
# Nautilus 脚本：PDF 合并
#
# 📌 使用方式：
# 1. 放到：
#    ~/.local/share/nautilus/scripts/
#
# 2. 文件管理器中：
#    - 选中多个 PDF
#    - 右键 → “脚本” → 点击本脚本
#
# 3. Nautilus 传参：
#    "$1" = 第一个PDF
#    "$@" = 所有PDF
#
# 示例：
#   /home/user/docs/A.pdf
#   /home/user/docs/B.pdf
#
# ============================================================


# ============================================================
# 0. 加载环境（避免 Nautilus 环境缺失）
# ============================================================
source ~/.zshrc 2>/dev/null || true


# ============================================================
# 1. 路径定义
# ============================================================

# 当前脚本目录
# 示例：~/.local/share/nautilus/scripts
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# 自 scripts/ 或其子目录向上找到含 lib/Office 的 nautilus 根
NAUTILUS_ROOT="$SCRIPT_DIR"
while [ "$NAUTILUS_ROOT" != "/" ] && [ ! -d "$NAUTILUS_ROOT/lib/Office" ]; do
    NAUTILUS_ROOT="$(dirname "$NAUTILUS_ROOT")"
done

# 解析 Python（不写死 venv 路径）：VIRTUAL_ENV → activate 文件 → PYTHON_VENV_DIR → PATH
if [ -f "$NAUTILUS_ROOT/lib/Office/resolve_python.sh" ]; then
  # shellcheck disable=SC1091
  source "$NAUTILUS_ROOT/lib/Office/resolve_python.sh"
  PYTHON="$(office_resolve_python)"
else
  PYTHON="$(command -v python3)"
fi

# 输入过滤（防点错）
if [ -f "$NAUTILUS_ROOT/lib/Office/nautilus_filter.sh" ]; then
  # shellcheck disable=SC1091
  source "$NAUTILUS_ROOT/lib/Office/nautilus_filter.sh"
  office_filter_by_ext 2 0 pdf -- "$@" || exit 1
  set -- "${OFFICE_FILES[@]}"
fi

# 工具库目录（包含 MergePdf.py）
LIB_DIR="$NAUTILUS_ROOT/lib/Office/PDF_Tools"

# 目标目录（选中文件所在目录）
# 示例：/home/user/docs
TARGET_DIR="$(dirname "$1")"

# 临时目录（运行环境）
# 示例：/home/user/docs/PDF_Tools_WP
TMP_PDF_DIR="$TARGET_DIR/PDF_Tools_WP"


# ============================================================
# 2. 清理旧临时目录
# ============================================================
rm -rf "$TMP_PDF_DIR"


# ============================================================
# 3. 复制工具到临时目录
# ============================================================
cp -r "$LIB_DIR" "$TMP_PDF_DIR"


# ============================================================
# 4. 创建 pdfPages 目录
# ⚠️ 必须和 MergePdf.py 内部读取目录一致
# ============================================================
mkdir -p "$TMP_PDF_DIR/input"


# ============================================================
# 5. 复制选中的 PDF 到 pdfPages/
# ============================================================
for pdf in "$@"; do
    cp "$pdf" "$TMP_PDF_DIR/input/"
done


# ============================================================
# 6. 进入临时目录执行合并
# ============================================================
cd "$TMP_PDF_DIR" || exit 1


# ============================================================
# 7. 执行合并
#
# 成功：
#   生成 output.pdf
# ============================================================
if "$PYTHON" mergePdf.py; then

    # ===== 检查输出文件 =====
    if [ -f "output.pdf" ]; then

        # ====================================================
        # 复制结果到原目录
        #
        # 示例：
        # /home/user/docs/合并结果.pdf
        # ====================================================
        cp "output.pdf" "$TARGET_DIR/../合并结果.pdf"

        notify-send "✅ 合并完成" "已保存：$TARGET_DIR/../合并结果.pdf"

    else
        notify-send "❌ 合并失败" "未生成 output.pdf"
        exit 1
    fi

else
    notify-send "❌ 合并失败" "脚本执行错误"
    exit 1
fi


# ============================================================
# 8. 返回上级目录
# ============================================================
cd ..


# ============================================================
# 9. 删除临时目录
# ============================================================
rm -rf "$TMP_PDF_DIR"