# 模板：normal
# 默认。已开 SSH。其余服务找到注释条，去掉行首 # 即可。
# 选用：sudo sw-rules
# 改完：sudo shorewall check && sudo shorewall reload
#
# ACTION		SOURCE		DEST		PROTO	DEST	SOURCE
#							PORT	PORT(S)
?SECTION ALL
?SECTION ESTABLISHED
?SECTION RELATED
?SECTION INVALID
?SECTION UNTRACKED
?SECTION NEW
Invalid(DROP)	net		$FW		tcp

# ============================================================
# SSH（已启用）
# 换端口时改成：ACCEPT	net	$FW	tcp	你的端口
# 只允许某 IP：SSH(ACCEPT)	net:1.2.3.4/32	$FW
# ============================================================
SSH(ACCEPT)	net		$FW
# ACCEPT	net	$FW	tcp	2053,2083,2087,2096
# ACCEPT	net	$FW	tcp	2082,2086

# ============================================================
# Ping
# ============================================================
Ping(DROP)	net		$FW
# Ping(ACCEPT)	net		$FW

# ============================================================
# HTTP / HTTPS（nginx + acme：80 续期，443 正式站）
# ============================================================
# Web(ACCEPT)	net		$FW
# ACCEPT	net	$FW	tcp	80,443

# ============================================================
# 邮件
# ============================================================
# ACCEPT	net	$FW	tcp	25,465,587
# ACCEPT	net	$FW	tcp	110,143,993,995

# ============================================================
# DNS（本机当解析器才开；一般 VPS 不要对公网开）
# ============================================================
# ACCEPT	net	$FW	udp	53
# ACCEPT	net	$FW	tcp	53

# ============================================================
# 数据库 / 面板（尽量只放行内网或管理 IP）
# ============================================================
# ACCEPT	net:192.168.1.0/24	$FW	tcp	3306
# ACCEPT	net:192.168.1.0/24	$FW	tcp	5432
# ACCEPT	net:192.168.1.0/24	$FW	tcp	6379
# ACCEPT	net:1.2.3.4/32		$FW	tcp	9090

# ============================================================
# 自定义 TCP 端口（改数字后取消注释）
# ============================================================
# ACCEPT	net	$FW	tcp	8080
# ACCEPT	net	$FW	tcp	8443

# ============================================================
# 本机主动出站已由 policy 的 $FW→net ACCEPT 放行，一般不用再写。
