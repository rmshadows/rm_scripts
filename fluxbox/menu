# 终端模拟器
[submenu] (Terminal Emulators - 终端)
  [exec] (Gnome-terminal) {gnome-terminal}
  [exec] (X-terminal) {Eterm -c green -t ml-theme-small -g 90x23 -L 10000 -O --shade 80}
  [exec] (Xfce4-terminal) {xfce4-terminal}
[end]

[submenu] (Fluxbox Settings - Fluxbox 设置)
  [exec] (Reconfigure - 重新加载Init配置) {fluxbox-remote reconfigure}
  [exec] (Reload Keys - 重新加载快捷键) {fluxbox-remote reloadkeys}
  [exec] (Edit Menu - 编辑菜单) {leafpad ~/.fluxbox/menu}
  [exec] (Edit Init - 编辑Init) {leafpad ~/.fluxbox/init}
  [exec] (Edit Keys - 编辑快捷键) {leafpad ~/.fluxbox/keys}
  [separator]
  [submenu] (Toggles - 开关)
    [exec] (Remote Actions - 远程控制) {~/.fluxbox/scripts/toggle/allow-remote-actions.sh}
    [exec] (Performance Mode - 性能模式) {~/.fluxbox/scripts/toggle/performance-mode.sh}
    [exec] (Toolbar Screen - 工具栏显示器) {~/.fluxbox/scripts/toggle/toolbar-onhead.sh}
    [exec] (Slit Dock - Slit停靠区) {~/.fluxbox/scripts/toggle/slit-enable.sh}
  [end]
  [submenu] (Display - 显示器)
    [exec] (Extend - 扩展双屏) {~/.fluxbox/scripts/display/xrandr-layout.sh extend}
    [exec] (Extend Left - 外屏在左) {~/.fluxbox/scripts/display/xrandr-layout.sh extend-left}
    [exec] (Mirror - 镜像同屏) {~/.fluxbox/scripts/display/xrandr-layout.sh mirror}
    [separator]
    [exec] (Internal Only - 仅内置屏) {~/.fluxbox/scripts/display/xrandr-layout.sh internal}
    [exec] (External Only - 仅外接屏) {~/.fluxbox/scripts/display/xrandr-layout.sh external}
    [separator]
    [exec] (Choose Layout - 旧版profile) {~/.fluxbox/scripts/display/xrandr-profile.sh}
    # 自动检测脚本: scripts/display/xrandr-layout.sh
    # 手动 profile: 编辑 ~/.fluxbox/config/display.profiles
    # 输出名覆盖: 编辑 ~/.fluxbox/config/display.conf
  [end]
  [submenu] (Tools - 工具)
    [exec] (Deploy - 部署到~/.fluxbox) {~/.fluxbox/scripts/tools/fluxbox-deploy.sh}
    [exec] (Sync Deploy - rsync部署) {~/.fluxbox/scripts/tools/fluxbox-sync.sh deploy}
    [exec] (Sync Backup - 备份到仓库) {~/.fluxbox/scripts/tools/fluxbox-sync.sh backup}
    [exec] (Add App Rule - 生成apps规则) {~/.fluxbox/scripts/tools/fluxbox-add-app.sh}
    [exec] (Rotate Log - 轮转日志) {~/.fluxbox/scripts/tools/rotate-fluxbox-log.sh}
  [end]
[end]

# 该模块需要手动配置
# [submenu] (Volume Control - 音量)
#   [exec] (Increase Volume - 增大音量) {amixer set Master 5%+}
#   [exec] (Decrease Volume - 降低音量) {amixer set Master 5%-}
#   [exec] (Mute - 静音) {amixer set Master toggle}
# [end]
[submenu] (Brightness - 亮度)
    # [exec] (Increase - 亮度增加) {xbacklight -inc 10}
    # [exec] (Decrease - 亮度减少) {xbacklight -dec 10}
    # [exec] (Increase - 亮度增加) {~/.fluxbox/scripts/brightnessControl/ddcutilBrightnessControl.sh 1}
    # [exec] (Decrease - 亮度减少) {~/.fluxbox/scripts/brightnessControl/ddcutilBrightnessControl.sh 0}
    [exec] (Increase - 亮度增加) {~/.fluxbox/scripts/brightnessControl/xrandrBrightnessControl.sh 1}
    [exec] (Decrease - 亮度减少) {~/.fluxbox/scripts/brightnessControl/xrandrBrightnessControl.sh 0}
[end]

[submenu] (Keyboard - 键盘布局)
      [exec] (normal) {setxkbmap us}
      [exec] (international) {setxkbmap us -variant intl}
[end]

# 系统管理
[submenu] (System - 系统)
  # [exec] (Lock Screen - 锁屏) {xscreensaver-command -lock}
  [exec] (Lock Screen - 锁屏) {i3lock -f -i ~/.fluxbox/backgrounds/1080.png}
  # [exec] (Lock Screen - 锁屏) {i3lock -c 000000}
  [submenu] (Power Options - 电源选项)
    [exec] (Toggle Confirm - 切换确认对话框) {~/.fluxbox/scripts/system/power-toggle.sh confirm}
    [exec] (Toggle Sudo Password - 切换sudo关机) {~/.fluxbox/scripts/system/power-toggle.sh password}
    # 编辑 ~/.fluxbox/config/power.conf 查看当前设置
  [end]
  # [exec] (Reboot - 重启) {sudo shutdown -r now}
  # [exec] (Poweroff - 关机) {sudo shutdown -P now}
[end]

[separator]
[restart] (Restart Fluxbox - 重载Fluxbox)
[exit] (Exit Session - 注销)
[exec] (Reboot - 重启) {~/.fluxbox/scripts/system/power-action.sh reboot}
[exec] (Poweroff - 关机) {~/.fluxbox/scripts/system/power-action.sh poweroff}
# [exec] (Reboot - 重启) {sudo shutdown -r now}
# [exec] (Poweroff - 关机) {sudo shutdown -P now}
[end]
