[begin] (Fluxbox Menu)
#==============================================================================
# menu — 桌面右键主菜单
#
# 修改后: fluxbox-remote reconfigure
# 菜单: Fluxbox Settings → Edit Menu
#
# 语法:
#   [submenu] (标题) ... [end]
#   [exec] (显示名) {命令}
#   [config] (项)     打开 init 配置对话框
#   [include] (路径)  引入子菜单文件
#   [separator]       分隔线
#
# Fork 后建议检查:
#   System 子菜单里的锁屏命令（因发行版/显示管理器而异）
#   应用路径（firefox/chromium/nautilus 等是否已安装）
#   大量 [exec] 行以 # 注释保留，按需取消注释
#==============================================================================

# 基本命令格式示例
# [submenu] (Label)
# [exec] (Label) {Command}
# [separator]

# 文件管理器
[submenu] (File Managers - 文件)
  [exec] (Nautilus) {nautilus}
  [exec] (Thunar) {thunar}
[end]

# 浏览器
[submenu] (Web Browsers - 浏览器)
  [exec] (Firefox) {firefox}
  [exec] (Chromium) {chromium}
  # [exec] (Google Chrome) {chrome}
[end]

# 常用应用
[submenu] (Applications - 应用)
  # [exec] (Vim) {x-terminal-emulator -e vim}
  # [exec] (Mousepad) {mousepad}
  [exec] (LibreOffice) {libreoffice}
  [exec] (GIMP) {gimp}
[end]

