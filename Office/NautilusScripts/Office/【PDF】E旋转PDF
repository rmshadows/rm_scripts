#!/bin/bash
# ============================================================
# Nautilus 脚本：PDF旋转（带交互）
#
# 功能：
# - 右键选择PDF
# - 弹窗选择旋转方向（右90 / 左90 / 180）
# - 询问是否覆盖原文件
# - 自动调用 rotate_pdf_pages.py
# ============================================================


# ============================================================
# 0. 环境变量
# ============================================================
source ~/.zshrc


# ============================================================
# 1. 路径
# ============================================================
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
LIB_DIR="$SCRIPT_DIR/../lib/Office/PDF_Tools"

TARGET_DIR="$(dirname "$1")"
TMP_PDF_DIR="$TARGET_DIR/PDF_Tools_WP"


# ============================================================
# 2. 选择旋转方向
# ============================================================
direction=$(zenity --list \
    --title="选择旋转方向" \
    --column="选项" \
    --column="说明" \
    r "顺时针 90°" \
    l "逆时针 90°" \
    u "旋转 180°" \
    --height=250 --width=300)

# 用户取消
[ -z "$direction" ] && exit 0


# ============================================================
# 3. 是否覆盖原文件（-d）
# ============================================================
zenity --question \
    --title="是否覆盖原文件？" \
    --text="选择“是”：覆盖原PDF\n选择“否”：生成 rotated_ 前缀文件"

if [ $? -eq 0 ]; then
    delete_flag="-d"
else
    delete_flag=""
fi


# ============================================================
# 4. 清理临时目录
# ============================================================
rm -rf "$TMP_PDF_DIR"


# ============================================================
# 5. 复制工具
# ============================================================
cp -r "$LIB_DIR" "$TMP_PDF_DIR"


# ============================================================
# 6. 创建 input
# ============================================================
mkdir -p "$TMP_PDF_DIR/input"


# ============================================================
# 7. 复制PDF
# ============================================================
for pdf in "$@"; do
    cp "$pdf" "$TMP_PDF_DIR/input/"
done


# ============================================================
# 8. 执行脚本
# ============================================================
cd "$TMP_PDF_DIR" || exit 1

if python3 rotatePdf.py "$direction" $delete_flag; then

    RESULT_DIR="$TARGET_DIR/../PDF旋转结果"
    mkdir -p "$RESULT_DIR"

    # 覆盖模式：直接复制最终PDF（已经是原文件名）
    if [ -n "$delete_flag" ]; then
        cp input/*.pdf "$RESULT_DIR/" 2>/dev/null
    else
        # 非覆盖模式：只复制 rotated_ 文件
        cp input/rotated_*.pdf "$RESULT_DIR/" 2>/dev/null
    fi

    # 判断是否真的有结果
    if [ "$(ls -A "$RESULT_DIR" 2>/dev/null)" ]; then
        notify-send "✅ 旋转完成" "已保存：$RESULT_DIR"
    else
        notify-send "❌ 失败" "未生成结果文件"
        exit 1
    fi

else
    notify-send "❌ 失败" "脚本执行错误"
    exit 1
fi


# ============================================================
# 9. 清理
# ============================================================
cd ..
rm -rf "$TMP_PDF_DIR"